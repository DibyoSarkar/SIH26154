# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Uploads
MAX_UPLOAD_MB=15

# Database (SQLite file path). See README for Postgres migration notes.
SQLITE_PATH=./data/contentforge.db
